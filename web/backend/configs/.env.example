# Copy to web/backend/.env locally; never commit real credentials.
M3_DATABASE_URL=postgresql+psycopg://sigma_m3_app:REPLACE_LOCALLY@127.0.0.1:55432/sigma_m3
M3_TEST_DATABASE_URL=postgresql+psycopg://sigma_m3_app:REPLACE_LOCALLY@127.0.0.1:55432/sigma_m3_test
M3_SOURCE_ROOT=C:/path/to/local/source-workspace
M3_OUTPUT_ROOT=C:/path/to/local/private/outputs/m3
M3_FRONTEND_ORIGIN=http://127.0.0.1:5173
