# Demo source/seed prepared by the D2 operator workflow; no monthly package.
M3_MODE=demo
M3_DATABASE_URL=postgresql://demo_app:REPLACE_LOCALLY@127.0.0.1:55432/sigma_demo
M3_FRONTEND_ORIGIN=https://REPLACE-WITH-DEMO.vercel.app
M3_DEMO_ROOT=/var/data/sigma-demo
M3_SOURCE_ROOT=/var/data/sigma-demo/source
M3_OUTPUT_ROOT=/var/data/sigma-demo/outputs/m3
# One API process and one queue worker; admission is shared in PostgreSQL.
M3_DEMO_ACTIVE_RUNS=2
M3_DEMO_RUNS_PER_HOUR=8
M3_DEMO_RETAINED_RUNS=16
M3_DEMO_WRITES_PER_MINUTE=60
M3_DEMO_BODY_BYTES=65536
M3_DEMO_JOB_SECONDS=7200
M3_DEMO_JOB_MEMORY_MB=4096
M3_DEMO_FREE_DISK_MB=512
M3_DEMO_DATABASE_MB=4096
M3_DEMO_REPLAY_DAYS=92
