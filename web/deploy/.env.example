# Copy as web/deploy/.env; never commit the real file.
# Generate the password locally: python -c "import secrets; print(secrets.token_hex(32))"
# Use the same value across restarts; changing it does not reset an existing PostgreSQL volume.
SIGMA_DB_PASSWORD=REPLACE_WITH_RANDOM_HEXADECIMAL_VALUE
SIGMA_DB_ADMIN_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEXADECIMAL_VALUE
SIGMA_REDIS_PASSWORD=REPLACE_WITH_THIRD_RANDOM_HEXADECIMAL_VALUE
SIGMA_PORT=8000
# Optional immutable build identity: full main commit SHA or v1.2.3 style release tag.
# Leave blank for editable/development builds to keep source-change guards.
SIGMA_RELEASE_VERSION=
# Optional absolute directory holding sigma_sim_data_orders.csv. Only mounted read-only.
# SIGMA_DATA_DIR=C:/path/to/private/data
